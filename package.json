{
  "name": "pingboard",
  "private": true,
  "scripts": {
    "build": "cargo tauri build",
    "desktop-assets": "tsc --noEmit && vite build && cp index.html dist/",
    "test": "npm run desktop-assets && node --test tests/*.test.mjs",
    "test:macos": "bash tests/macos/run.sh",
    "test:ui": "npm run desktop-assets && node --test tests/ui/*.mjs",
    "start": "cargo tauri dev",
    "prebuild": "cargo tauri icon src-tauri/icon.svg",
    "prestart": "cargo tauri icon src-tauri/icon.svg"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "version": "0.4.4",
  "type": "module"
}
